# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Roblox OAuth 2.0 Credentials (Optional)
# Create an OAuth 2.0 application on the Roblox Creator Dashboard (https://create.roblox.com/dashboard/credentials)
# Add your dynamic staging or production URL to the "Redirect URIs" (e.g. https://your-app-domain/api/roblox/oauth-callback)
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Discord OAuth 2.0 Credentials (Optional)
# Create a Discord application on the Discord Developer Portal (https://discord.com/developers/applications)
# Add your dynamic staging or production URL to the "Redirect URIs" (e.g. https://your-app-domain/api/discord/oauth-callback)
DISCORD_CLIENT_ID=1523415843294416936
DISCORD_CLIENT_SECRET=3bBMAw0EDHZ9QwA_VeenX8oZ861zdT7Q

# Admin Panel Password
ADMIN_PASSWORD=

# Firebase Service Account JSON (Optional for external hosting like Render/Vercel)
FIREBASE_SERVICE_ACCOUNT=

